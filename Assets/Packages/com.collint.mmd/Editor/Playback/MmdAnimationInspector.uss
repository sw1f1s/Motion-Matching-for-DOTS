.mmd-animation-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.mmd-animation-field {
    min-width: 0;
    margin: 2px 0;
    align-items: center;
}

.mmd-animation-row > .mmd-animation-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.mmd-animation-inspector .mmd-animation-field > .unity-base-field__label {
    width: 132px;
    min-width: 132px;
    flex-shrink: 0;
    margin-right: 6px;
    -unity-text-align: middle-left;
}

.mmd-animation-field > .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.mmd-animation-field .unity-base-popup-field__text {
    overflow: hidden;
    text-overflow: ellipsis;
}

.mmd-animation-field .unity-slider__input-field {
    width: 48px;
    min-width: 48px;
}

.mmd-animation-block {
    margin-top: 6px;
}

.mmd-animation-block .unity-foldout {
    margin-top: 6px;
}

.mmd-animation-inspector .unity-foldout__content {
    margin-left: 15px;
}

.mmd-animation-inspector .unity-foldout__toggle {
    margin-left: 0;
}

.mmd-animation-layer-header {
    flex-wrap: nowrap;
}

.mmd-animation-layer-header > .unity-foldout__toggle {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mmd-animation-layer-header .unity-toggle__text {
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mmd-animation-actions {
    flex-wrap: nowrap;
    flex-shrink: 0;
    margin-left: 8px;
}
